# ========================
# Dependencies
# ========================
node_modules/
# NOTE: package-lock.json is deliberately COMMITTED (root, backend/, streamtor/).
# The Dockerfile installs with `npm ci`, which refuses to run without a
# lockfile - cloud builds (Koyeb, Oracle VM, CI) clone the repo fresh, so
# ignoring these files would break every out-of-the-machine build.

# ========================
# Environment & Secrets
# ========================
.env
.env.local
.env.*.local
backend/.env

# ========================
# Build Output
# ========================
dist/
dist-ssr/
backend/dist/

# ========================
# Storage & Uploads
# ========================
backend/storage/uploads/
backend/storage/jobs/
backend/storage/temp/
!backend/storage/.gitkeep

# ========================
# Torrent Data
# ========================
.torrents/
.torrent-cache/
streamtor/.torrents/
*.torrent

