{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --include=dev && npm install --include=dev --prefix backend",
  "buildCommand": "npm run build && npm run --prefix backend build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.ts": {
      "maxDuration": 300,
      "memory": 2048,
      "includeFiles": "backend/node_modules/{strtok3,token-types,uint8array-extras,@tokenizer/inflate,@tokenizer/token,@borewit/text-codec,ieee754,debug}/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/v1/:route*",
      "destination": "/api/backend?p=/v1/:route*"
    },
    {
      "source": "/health",
      "destination": "/api/backend?p=/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
