# ==============================================================================
# DocFlow - production environment template (.env.production.example)
#
# One container runs the whole product: the React SPA and the Fastify API (with
# inline queue workers). The same file is used for
# every deployment target:
#
#   VM / Docker Compose  ->  copy to .env next to docker-compose.yml
#   Koyeb                ->  paste into the service environment variables
#                            (see KOYEB_DEPLOYMENT.md)
#
# VITE_* values are read at BUILD time: on a VM run `docker compose build`
# after changing them, on Koyeb click Redeploy.
#
# Never commit real credentials or production secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration & Networking
# ------------------------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
NODE_ENV=production
# Cap the Node V8 heap so Node and LibreOffice coexist without OOM.
# 192MB suits a 512MB free instance; raise it (e.g. 768) on a 12GB VM.
NODE_OPTIONS=--max-old-space-size=192
# Set to 1 when a reverse proxy (Koyeb, Cloudflare, nginx) terminates TLS in
# front of the container so Fastify reads the real client IP from
# X-Forwarded-For. Leave at 0 on a bare VM that serves traffic directly.
TRUST_PROXY=1
# Allowed origins for CORS. In the all-in-one container the SPA and the API
# share one origin, so leave this EMPTY (the default). Only if you also host
# a frontend elsewhere (e.g. Vercel) set it to that exact URL - "*" is
# rejected by the production boot check.
CORS_ORIGIN=

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL on Neon)
# ------------------------------------------------------------------------------
# Neon connection pooling URL (for standard API queries)
DATABASE_URL=postgresql://docflow_api:PLACEHOLDER_PASSWORD@ep-xyz-pooler.us-east-2.aws.neon.tech/docflow_db?sslmode=require
# Neon connection pooling URL for background worker
DATABASE_URL_WORKER=postgresql://docflow_worker:PLACEHOLDER_PASSWORD@ep-xyz-pooler.us-east-2.aws.neon.tech/docflow_db?sslmode=require
# Direct unpooled connection URL (used strictly for running schema migrations)
DATABASE_URL_DIRECT=postgresql://docflow_owner:PLACEHOLDER_PASSWORD@ep-xyz.us-east-2.aws.neon.tech/docflow_db?sslmode=require
# Automatically run unapplied database migrations on container start
RUN_MIGRATIONS_ON_START=true

# ------------------------------------------------------------------------------
# 3. Redis Queue & Rate Limiting
# ------------------------------------------------------------------------------
# Start local in-container Redis (maxmemory 64mb, noeviction, no persistence)
LOCAL_REDIS=true
REDIS_URL=redis://127.0.0.1:6379

# BullMQ polling tunables
BULLMQ_DRAIN_DELAY_SEC=5
BULLMQ_STALLED_INTERVAL_MS=30000
# In-memory rate limiting fallback for heavy routes if Redis is down
RATE_LIMIT_EXPENSIVE_FALLBACK=memory

# ------------------------------------------------------------------------------
# 4. Worker & Resource Limits
# ------------------------------------------------------------------------------
# Run queue workers inline within the API process (saves a separate worker service)
RUN_INLINE_WORKERS=true
# All-in-one deployment shape; required for RUN_INLINE_WORKERS=true to pass the
# production boot check. The root image already sets it - listed here for clarity.
SINGLE_CONTAINER=true
WORKER_CONCURRENCY=1
# Heavy job lock: limits simultaneous LibreOffice/FFmpeg/PdfToDocx tasks to 1
HEAVY_JOB_CONCURRENCY=1
# Max upload size limit (15 MB in bytes)
MAX_UPLOAD_BYTES=15728640
# Clean up temporary uploads and conversion artifacts after 15 minutes
ARTIFACT_TTL_MINUTES=15
# Disable heavy OCR scanner on free tier (avoids high CPU/memory usage)
PDF_DOCX_OCR=off
# DOCX conversion limits
PDF_DOCX_MAX_PAGES=30
PDF_DOCX_MAX_BYTES=10485760
PDF_DOCX_TIMEOUT_MS=180000

# ------------------------------------------------------------------------------
# 5. Email Delivery (Resend HTTPS API)
# ------------------------------------------------------------------------------
EMAIL_TRANSPORT=resend
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=DocFlow <noreply@yourdomain.com>

# ------------------------------------------------------------------------------
# 6. Authentication (Firebase Admin SDK)
# ------------------------------------------------------------------------------
# Minified single-line JSON string of your Firebase service account key
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"..."}

# ------------------------------------------------------------------------------
# 7. Frontend build-time configuration (Vite, read during `docker build`)
# ------------------------------------------------------------------------------
# Vite inlines VITE_* into the browser bundle at build time. The Dockerfile
# declares each one as an ARG, and docker-compose.yml maps them from this file
# (on Koyeb the service environment variables are forwarded to the build
# instead). They are public browser identifiers, not secrets - Firebase ships
# them to every visitor anyway.
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
# Keep empty: the SPA then uses same-origin relative URLs, which is what
# you want while the API and the SPA are served by the same container.
VITE_API_BASE_URL=
