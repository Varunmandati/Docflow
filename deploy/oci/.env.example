# =============================================================================
# DocFlow - production environment (Oracle A1 / ARM64)
#
#   cp .env.example .env
#   chmod 600 .env
#   ./setup.sh          # generates every secret, then builds and starts
#
# NEVER commit .env. It is in .gitignore and in .dockerignore. Values marked
# REQUIRED have no safe default; setup.sh will generate the ones it can and
# refuse to start while any are still missing.
# =============================================================================

# ── Public identity ─────────────────────────────────────────────────────────
# The domain the certificate is issued for and the SPA is served from. Must
# already have an A record pointing at the instance's public IP.
DOCFLOW_DOMAIN=docflow.example.com

# Contact address for the ACME account and certificate expiry notices.
ACME_EMAIL=admin@docflow.example.com


# ── Internal secrets (setup.sh generates these) ─────────────────────────────
# Password for the internal Redis. Used by api, worker and the redis entrypoint.
REDIS_PASSWORD=

# Set to 384mb unless you have measured otherwise. Kept separate from the
# Compose memory limit so Redis's own ceiling is always the lower of the two.
REDIS_MAXMEMORY=384mb


# ── Database (Neon) ─────────────────────────────────────────────────────────
# The pooled connection string. Do NOT add ?pgbouncer=true here: the api uses
# this one for request handling and transaction-scoped work.
DATABASE_URL=

# The direct (non-pooled) connection string. Required for migrations and for
# anything that must not sit behind a transaction pool. Create it in the Neon
# console and paste the `-pooled` one's sibling here.
DATABASE_URL_DIRECT=

# Dedicated connection string for the worker.
#
# It needs BYPASSRLS, which the API role must NOT have: the worker reads every
# user's job rows without a per-user JWT claim. Grant it to a separate role
# rather than reusing the api role, so a compromise of the request path does not
# hand over the whole table.
DATABASE_URL_WORKER=


# ── Auth / email ────────────────────────────────────────────────────────────
# Firebase Admin SDK. The whole JSON key as a single line, with literal \n
# sequences inside the private_key (not real newlines - .env cannot hold them).
# In production, prefer GOOGLE_APPLICATION_CREDENTIALS + a mounted file; this
# variable exists for single-host deployments where that is awkward.
FIREBASE_SERVICE_ACCOUNT=

# Email delivery. 'resend' avoids needing an SMTP relay with a port 25 exemption.
EMAIL_TRANSPORT=resend
RESEND_API_KEY=
EMAIL_FROM="DocFlow <noreply@docflow.example.com>"

# Only used when EMAIL_TRANSPORT=smtp. Leave blank for resend.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=


# ── Frontend build arguments ────────────────────────────────────────────────
# Vite inlines these into the bundle at BUILD time, so they must be set before
# the first `docker compose build`. Changing one requires a rebuild, not just a
# restart. Find them in Firebase console -> Project settings -> Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Leave VITE_API_BASE_URL EMPTY.
#
# The production topology is same-origin: Caddy serves the SPA and the API from
# one public origin, so relative /v1 calls are correct. Setting
# this makes the browser make a cross-origin request, which then needs
# CORS and (worse) exposes the Firebase bearer token to a second origin.


# ── Optional: Gemini-based features ─────────────────────────────────────────
# Leave empty to disable. Used for AI-assisted document tooling only.
GEMINI_API_KEY=


# ── Resource tuning ────────────────────────────────────────────────────────
# How many conversion jobs the worker runs in parallel. Each one may spawn a
# LibreOffice process, so this is the main driver of peak memory. Start at 1 on
# a 1-OCPU/12GB A1 shape; 2 is reasonable on 2 OCPUs.
WORKER_CONCURRENCY=1

# Worker DB pool. Deliberately small and separate from the api's: a pool per
# container times the number of containers must stay under Neon's connection
# limit, or both the api and the worker start failing with 53300.
WORKER_DB_POOL_MAX=4
DB_POOL_MIN=1
DB_POOL_MAX=5

# Memory ceilings. Docker enforces these with cgroups, so a runaway conversion
# is killed rather than triggering the kernel OOM killer and taking the API down
# with it.
WORKER_MEMORY_LIMIT=3g
REDIS_MEMORY_LIMIT=512m

# Upload ceiling. Must be <= MAX_UPLOAD_BYTES in the API and the 512MB
# request_body limit in the Caddyfile, or the smallest of the three wins and the
# others are misleading.
MAX_UPLOAD_BYTES=104857600

# Run `npm run migrate` (or `docker compose run --rm api node
# backend/dist/db/migrate.js`) before the first start, then leave this false.
# Two containers racing migrations on every boot is a bad trade for the
# convenience.
RUN_MIGRATIONS_ON_START=false


# ── Observability ───────────────────────────────────────────────────────────
# fatal | error | warn | info | debug | trace
# `info` in production: `debug` logs every request including URLs, which is
# noisy and leaks request paths.
LOG_LEVEL=info

# `memory` uses an in-process store for the rate limiter instead of Redis.
# Required if you ever scale the API to more than one replica, because an
# in-process counter is per-container. `open` fails open (no limiting) if Redis
# is unreachable, which is the right trade for a single-replica deployment.
RATE_LIMIT_EXPENSIVE_FALLBACK=memory
