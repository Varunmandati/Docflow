# ==============================================
# DocFlow - Environment Configuration Template
# ==============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ==============================================

# Upload Server Configuration
UPLOAD_SERVER_PORT=3002

# Firebase Google Auth
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
# Leave empty for local dev so the Vite proxy forwards /v1 and /api/uploads
# Set VITE_HMR_CLIENT_PORT=443 when the dev server is behind an HTTPS proxy.
VITE_HMR_CLIENT_PORT=
# to the local backend and stream-service. Set to your deployed API origin for prod.
VITE_API_BASE_URL=
VITE_UPLOAD_SERVER_URL=

# SMTP Email (for OTP delivery)
# Gmail: Use your Gmail address + App Password
# Generate App Password: Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Docflow <your_email@gmail.com>"
