# ==============================================================================
# DocFlow - Render Free Tier Deployment Environment Variables (.env.render.example)
#
# Configure these variables in the Render Dashboard (Web Service -> Environment).
# One Render web service serves the whole product: React SPA, Fastify API,
# inline queue workers and an in-container Redis (see render.yaml).
# Never commit real credentials or production secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration & Networking
# ------------------------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
NODE_ENV=production
# Restrict V8 heap on 512MB RAM instance so Node and LibreOffice coexist without OOM
NODE_OPTIONS=--max-old-space-size=192
# Render terminates SSL; trust proxy headers so request.ip is client IP
TRUST_PROXY=true
# Allowed origins for CORS. One service serves the SPA and the API, so the
# default (empty) same-origin-only posture is correct - leave it unset/empty.
# "*" is rejected by the production boot check.
CORS_ORIGIN=

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL on Neon)
# ------------------------------------------------------------------------------
# Neon connection pooling URL (for standard API queries)
DATABASE_URL=postgresql://docflow_api:PLACEHOLDER_PASSWORD@ep-xyz-pooler.us-east-2.aws.neon.tech/docflow_db?sslmode=require
# Neon connection pooling URL for background worker
DATABASE_URL_WORKER=postgresql://docflow_worker:PLACEHOLDER_PASSWORD@ep-xyz-pooler.us-east-2.aws.neon.tech/docflow_db?sslmode=require
# Direct unpooled connection URL (used strictly for running schema migrations)
DATABASE_URL_DIRECT=postgresql://docflow_owner:PLACEHOLDER_PASSWORD@ep-xyz.us-east-2.aws.neon.tech/docflow_db?sslmode=require
# Automatically run unapplied database migrations on container start
RUN_MIGRATIONS_ON_START=true

# ------------------------------------------------------------------------------
# 3. Redis Queue & Rate Limiting
# ------------------------------------------------------------------------------
# Start local in-container Redis (maxmemory 64mb, noeviction, no persistence)
LOCAL_REDIS=true
REDIS_URL=redis://127.0.0.1:6379
# If using external Redis (e.g. Upstash), set LOCAL_REDIS=false and provide:
# REDIS_URL=rediss://default:PLACEHOLDER_TOKEN@your-upstash-redis.upstash.io:6379

# BullMQ polling tunables (tuned to prevent command starvation)
BULLMQ_DRAIN_DELAY_SEC=5
BULLMQ_STALLED_INTERVAL_MS=30000
# In-memory rate limiting fallback for heavy routes if Redis is down
RATE_LIMIT_EXPENSIVE_FALLBACK=memory

# ------------------------------------------------------------------------------
# 4. Worker & Resource Limits (512 MB Free Tier)
# ------------------------------------------------------------------------------
# Run queue workers inline within the API process (saves a separate worker service)
RUN_INLINE_WORKERS=true
# All-in-one shape (SPA + API + workers in one container); required for
# RUN_INLINE_WORKERS=true to pass the production boot check. render.yaml sets it.
SINGLE_CONTAINER=true
WORKER_CONCURRENCY=1
# Heavy job lock: limits simultaneous LibreOffice/FFmpeg/PdfToDocx tasks to 1
HEAVY_JOB_CONCURRENCY=1
# Max upload size limit (15 MB in bytes)
MAX_UPLOAD_BYTES=15728640
# Clean up temporary uploads and conversion artifacts after 15 minutes
ARTIFACT_TTL_MINUTES=15

# ------------------------------------------------------------------------------
# 5. Engine & PDF-to-DOCX Configuration
# ------------------------------------------------------------------------------
PDF_DOCX_MAX_PAGES=30
PDF_DOCX_MAX_BYTES=10485760
PDF_DOCX_TIMEOUT_MS=180000
# Turn off OCR to protect CPU and memory limits on scanned PDFs
PDF_DOCX_OCR=off
PDF_DOCX_ENGINE=auto

# ------------------------------------------------------------------------------
# 6. Email Delivery (HTTPS API via Resend - Bypasses Render SMTP Block)
# ------------------------------------------------------------------------------
# Render blocks outbound ports 25, 465, and 587. Resend uses HTTPS API.
EMAIL_TRANSPORT=resend
RESEND_API_KEY=re_123456789_PLACEHOLDER
EMAIL_FROM=DocFlow <onboarding@resend.dev>

# Optional legacy SMTP fallback (only for environments where SMTP ports are open)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=DocFlow <your_email@gmail.com>

# ------------------------------------------------------------------------------
# 7. Authentication & Integrations
# ------------------------------------------------------------------------------
# Firebase Admin SDK Service Account JSON string (escaped into a single line)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id","private_key_id":"keyid","private_key":"-----BEGIN PRIVATE KEY-----\\nPLACEHOLDER_KEY\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk@your-project-id.iam.gserviceaccount.com"}

# Alternatively, configure individual Firebase private key.
# NOTE ON NEWLINE HANDLING: Render and Linux environment variables treat literal \n as characters '\\' and 'n'.
# When entering FIREBASE_PRIVATE_KEY in the Render Dashboard, paste the multiline PEM key directly,
# or if using a single-line string with escaped newlines, wrap in quotes: "-----BEGIN PRIVATE KEY-----\nMIIEvg...-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPLACEHOLDER_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Optional Gemini API key for intelligent filename suggestions
GEMINI_API_KEY=PLACEHOLDER_GEMINI_KEY

# ==============================================================================
# FRONTEND BUILD CONFIGURATION (Set in Render Dashboard -> Environment)
# ==============================================================================
# The root Dockerfile builds the React SPA inside the Render image, and Render
# passes every service environment variable to `docker build` as a build
# argument - so set these BEFORE the first deploy, or run "Clear build cache &
# deploy" afterwards (Vite inlines them into the browser bundle at build time).
#
# Empty base URL = same-origin API calls, which is correct: this one service
# serves both the SPA and the API.
VITE_API_BASE_URL=

# Firebase Client Web Configuration
VITE_FIREBASE_API_KEY=AIzaSyPLACEHOLDER_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
