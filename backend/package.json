{
  "name": "docflow-conversion-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade document conversion backend using LibreOffice headless + BullMQ",
  "main": "dist/index.api.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-migrations.mjs",
    "dev:api": "tsx watch src/index.api.ts",
    "dev:worker": "tsx watch src/index.worker.ts",
    "start:api": "node dist/index.api.js",
    "start:worker": "node dist/index.worker.js",
    "migrate": "tsx src/db/migrate.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
    "@aws-sdk/s3-request-presigner": "^3.1148.0",
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^12.0.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.12.12",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "fast-xml-parser": "^5.10.1",
    "fastify": "^5.12.0",
    "file-type": "^22.0.1",
    "firebase-admin": "^14.2.0",
    "heic-decode": "^2.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "mime-types": "^2.1.35",
    "nodemailer": "^9.0.5",
    "pdf-lib": "^1.17.1",
    "pg": "^8.11.3",
    "pino": "^9.4.0",
    "sharp": "^0.35.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.11.4",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2",
    "vitest": "^4.1.10"
  }
}
