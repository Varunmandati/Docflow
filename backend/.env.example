# ==============================================
# DocFlow Backend - Environment Configuration
# ==============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ==============================================

# Server
# Locally 8090 is used to avoid clashing with other projects on 8080.
PORT=8090
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000,http://localhost:8090
LOG_LEVEL=info
NODE_ENV=development

# Redis
REDIS_URL=redis://localhost:6379

# Storage
STORAGE_ROOT=./storage

# LibreOffice & PDF Tools
SOFFICE_BINARY=soffice
PDFTOPPM_BINARY=pdftoppm
PDFTOTEXT_BINARY=pdftotext
PDF2HTMLEX_BINARY=pdf2htmlEX

# Job Queue
CONVERSION_TIMEOUT_MS=180000
WORKER_CONCURRENCY=2
JOB_ATTEMPTS=3
JOB_BACKOFF_MS=5000

# SMTP Email (for OTP delivery)
# Gmail: Use your Gmail address + App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="DocFlow <your_email@gmail.com>"

# OTP Configuration
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5

# Auth Secrets (CHANGE THESE IN PRODUCTION!)
AUTH_TOKEN_SECRET=change_this_to_a_long_random_secret
REFRESH_TOKEN_SECRET=change_this_to_another_long_random_secret

# Gemini API Key (server-side only - used for AI filename suggestions).
# NEVER expose this in the frontend bundle.
GEMINI_API_KEY=your_gemini_api_key

# PostgreSQL Configuration
# Example uses Neon (pooled). Replace with your host + credentials.
# Note: node-postgres ignores the channel_binding param; sslmode=require is used.
DATABASE_URL=postgresql://user:CHANGE_ME@host-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL_WORKER=postgresql://user:CHANGE_ME@host-pooler.region.aws.neon.tech/dbname?sslmode=require
POSTGRES_ADMIN_URL=postgresql://user:CHANGE_ME@host-pooler.region.aws.neon.tech/dbname?sslmode=require
POSTGRES_ADMIN_PASSWORD=CHANGE_ME

# Connection Pool
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000

# PDF to DOCX Conversion Feature Flags and Limits
# PDF_DOCX_ENGINE=auto (default) or "legacy" to use old PyMuPDF layout approach
PDF_DOCX_ENGINE=auto
PDF_DOCX_MAX_PAGES=500
PDF_DOCX_MAX_BYTES=209715200
PDF_DOCX_TIMEOUT_MS=600000
PDF_DOCX_PYTHON=python3
PDF_DOCX_OCRMYPDF=ocrmypdf
