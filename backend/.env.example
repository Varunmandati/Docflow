# ==============================================
# DocFlow Backend - Environment Configuration
# ==============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ==============================================

# Server
PORT=8080
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000,http://localhost:8080
LOG_LEVEL=info
NODE_ENV=development

# Redis
REDIS_URL=redis://localhost:6379

# Storage
STORAGE_ROOT=./storage

# LibreOffice & PDF Tools
SOFFICE_BINARY=soffice
PDFTOPPM_BINARY=pdftoppm
PDFTOTEXT_BINARY=pdftotext
PDF2HTMLEX_BINARY=pdf2htmlEX

# Job Queue
CONVERSION_TIMEOUT_MS=180000
WORKER_CONCURRENCY=2
JOB_ATTEMPTS=3
JOB_BACKOFF_MS=5000

# SMTP Email (for OTP delivery)
# Gmail: Use your Gmail address + App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="DocFlow <your_email@gmail.com>"

# OTP Configuration
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5

# Auth Secrets (CHANGE THESE IN PRODUCTION!)
AUTH_TOKEN_SECRET=change_this_to_a_long_random_secret
REFRESH_TOKEN_SECRET=change_this_to_another_long_random_secret

# PostgreSQL Configuration
DATABASE_URL=postgresql://docflow_api:CHANGE_ME@localhost:5435/docflow?sslmode=disable
DATABASE_URL_WORKER=postgresql://docflow_worker:CHANGE_ME@localhost:5435/docflow?sslmode=disable
POSTGRES_ADMIN_URL=postgresql://docflow_admin:CHANGE_ME@localhost:5435/docflow?sslmode=disable
POSTGRES_ADMIN_PASSWORD=CHANGE_ME

# Connection Pool
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
